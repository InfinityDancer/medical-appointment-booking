{
  "version": "6.0",
  "screens": [
    {
      "id": "DOCTOR_SELECTION",
      "title": "Select a Doctor",
      "terminal": true,
      "data": {
        "doctors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "doc_1",
              "title": "Dr Neelesh Gupta (Glaucoma)"
            },
            {
              "id": "doc_2",
              "title": "Dr Nilesh Kumar (Cornea)"
            }
          ]
        },
        "header_text": {
          "type": "string",
          "__example__": "Please select a doctor for your appointment"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "doctor_form",
            "children": [
              {
                "type": "TextBody",
                "text": "${data.header_text}"
              },
              {
                "type": "Dropdown",
                "name": "selected_doctor",
                "label": "Choose a Doctor",
                "required": true,
                "data-source": "${data.doctors}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "selected_doctor": "${form.selected_doctor}",
                    "flow_type": "doctor_selection"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}